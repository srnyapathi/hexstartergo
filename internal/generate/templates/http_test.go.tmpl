package http
import("context";"errors";"net/http";"net/http/httptest";"testing";"sync/atomic";"{{.Module}}/internal/application")
func TestReadiness(t *testing.T){for _,tc:=range []struct{name string;ready func(context.Context)error;status int;body string}{ {"application",application.Ready,200,"ready\n"},{"unavailable",func(context.Context)error{return errors.New("unavailable")},503,"not ready\n"}}{t.Run(tc.name,func(t *testing.T){w:=httptest.NewRecorder();Handler(tc.ready).ServeHTTP(w,httptest.NewRequest(http.MethodGet,"/readyz",nil));if w.Code!=tc.status||w.Body.String()!=tc.body{t.Fatalf("%d %q",w.Code,w.Body.String())}})}}
func TestCanceledReadiness(t *testing.T){ctx,cancel:=context.WithCancel(context.Background());cancel();r:=httptest.NewRequest(http.MethodGet,"/readyz",nil).WithContext(ctx);w:=httptest.NewRecorder();Handler(application.Ready).ServeHTTP(w,r);if w.Code!=503||w.Body.String()!="not ready\n"{t.Fatalf("%d %q",w.Code,w.Body.String())}}

func TestReadinessCallsApplication(t *testing.T){var called atomic.Int32;ready:=func(ctx context.Context)error{called.Add(1);if _,ok:=ctx.Deadline();!ok{return errors.New("missing readiness deadline")};return nil};w:=httptest.NewRecorder();Handler(ready).ServeHTTP(w,httptest.NewRequest(http.MethodGet,"/readyz",nil));if called.Load()!=1||w.Code!=http.StatusOK{t.Fatalf("called=%d status=%d",called.Load(),w.Code)}}
func TestNoBusinessRoute(t *testing.T){var called atomic.Int32;handler:=Handler(func(context.Context)error{called.Add(1);return nil});for _,path:=range []string{"/","/orders","/users"}{w:=httptest.NewRecorder();handler.ServeHTTP(w,httptest.NewRequest(http.MethodGet,path,nil));if w.Code!=http.StatusNotFound{t.Errorf("%s: %d",path,w.Code)}};if called.Load()!=0{t.Fatal("business route invoked readiness")}}
